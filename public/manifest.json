{
  "manifest_version": 3,
  "name": "Wikeep - Save and search DeepWiki",
  "description": "Save and search DeepWiki conversations locally.",
  "version": "0.1.0",
  "permissions": ["storage", "sidePanel", "activeTab"],
  "host_permissions": [
    "https://deepwiki.com/*",
    "https://api.devin.ai/ada/query/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://deepwiki.com/search/*", "https://deepwiki.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://deepwiki.com/*"],
      "js": ["pageWorldProbe.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Wikeep",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
